# ============================================
# DESTINY DEVELOPMENT ENVIRONMENT
# ============================================
# Purpose: Framework development and testing
# Access: FULL read/write
# Use for: CBA reports, experiments, prototyping
# Safe to: Drop databases, recreate, experiment
# ============================================

ENVIRONMENT=development
READ_ONLY=false

# ============================================
# DESTINY DEVELOPMENT DATABASES
# Different ports to avoid conflicts!
# ============================================

# PostgreSQL (Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=destiny_dev
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_dev_2024

# Qdrant (Development)
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# Neo4j (Development)
NEO4J_URL=http://localhost:7475
NEO4J_USER=neo4j
NEO4J_PASSWORD=destiny_dev_2024
NEO4J_BOLT_URL=bolt://localhost:7688

# Elasticsearch (Development)
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Redis (Development)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# ============================================
# ACCESS CONTROL
# ============================================
ALLOW_WRITE=true
ALLOW_DELETE=true
ALLOW_SCHEMA_CHANGES=true

# ============================================
# LMSTUDIO (Shared between environments)
# ============================================
LMSTUDIO_URL=http://192.168.200.226:1234/v1
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-multilingual-e5-large-instruct

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
DEBUG=true
LOG_LEVEL=DEBUG
ENABLE_PROFILING=true
