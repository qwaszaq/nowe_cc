# ============================================
# DESTINY - Main Configuration
# ============================================
# Auto-generated from .env.development
# Date: 2024-11-05
# ============================================

ENVIRONMENT=development
READ_ONLY=false

# ============================================
# DATABASE PORTS (Development - no conflicts!)
# ============================================

# PostgreSQL (Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=destiny_dev
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_dev_2024

# Qdrant (Development)
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_COLLECTION=destiny_embeddings
QDRANT_URL=http://localhost:6335

# Neo4j (Development)
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=destiny_dev_2024
NEO4J_URL=http://localhost:7475
NEO4J_BOLT_URL=bolt://localhost:7688

# Elasticsearch (Development)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_INDEX=destiny_documents
ELASTICSEARCH_URL=http://localhost:9201

# Redis (Development)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# ============================================
# LMSTUDIO (OSS LLM)
# ============================================
LMSTUDIO_HOST=192.168.200.226
LMSTUDIO_PORT=1234
LMSTUDIO_URL=http://192.168.200.226:1234/v1
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_LLM_MODEL=openai/gpt-oss-20b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-multilingual-e5-large-instruct

# ============================================
# CLAUDE API (Optional supervision)
# ============================================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4.5-20241022
ENABLE_CLAUDE_SUPERVISION=false

# ============================================
# ACCESS CONTROL
# ============================================
ALLOW_WRITE=true
ALLOW_DELETE=true
ALLOW_SCHEMA_CHANGES=true

# ============================================
# SYSTEM SETTINGS
# ============================================
DEBUG=true
LOG_LEVEL=DEBUG
ENABLE_PROFILING=true
SUPERVISION_MODE=autonomous
VECTOR_THRESHOLD=100000
MAX_WORKERS=4
BATCH_SIZE=100
TIMEOUT_SECONDS=120
